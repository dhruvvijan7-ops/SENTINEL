# App environment: development | production | test
SENTINEL_ENV=development

# PostgreSQL (primary - start with: docker compose up -d)
DATABASE_URL=postgresql+psycopg2://sentinelai:sentinelai@localhost:5432/sentinelai
# SQLite fallback (uncomment the line below if PostgreSQL is not available):
# DATABASE_URL=sqlite:///./sentinelai.db

FRONTEND_ORIGIN=http://localhost:5173

# Auth - JWT access tokens.
# Use a strong secret in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production refuses to boot with a missing, short, or default secret.
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=sentinel.api
JWT_AUDIENCE=sentinel.frontend
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_TOKEN_EXPIRE_MINUTES=30

# Cookies
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=localhost

# First-party guard header sent by the frontend on mutating requests.
AUTH_CLIENT_HEADER_NAME=x-sentinel-client
AUTH_CLIENT_HEADER_VALUE=sentinel

# Development/test helper: returns the reset token inside the forgot-password reply.
# MUST be false in production - the app will refuse to boot otherwise.
DEBUG_RESET_RETURNS_TOKEN=true